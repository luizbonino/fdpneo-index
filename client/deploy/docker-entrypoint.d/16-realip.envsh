#!/bin/sh
# Behind another reverse proxy (TLS termination, a load balancer), the address
# that connects to this nginx is that proxy's, and every client would share
# one rate-limit bucket. FDPINDEX_TRUSTED_PROXY names that proxy (addresses or
# CIDR ranges, comma- or space-separated): nginx then takes the client's
# address from the X-Forwarded-For it sets, and passes that on to the server.
# Exported for the nginx template, like the CSP.
FDPINDEX_REALIP=""
if [ -n "${FDPINDEX_TRUSTED_PROXY:-}" ]; then
  for proxy in $(printf '%s' "$FDPINDEX_TRUSTED_PROXY" | tr ',' ' '); do
    case "$proxy" in
      *[!0-9a-fA-F.:/]*)
        echo "FDPINDEX_TRUSTED_PROXY: '$proxy' is not an address or CIDR range" >&2
        exit 1
        ;;
    esac
    FDPINDEX_REALIP="${FDPINDEX_REALIP}set_real_ip_from $proxy; "
  done
  FDPINDEX_REALIP="${FDPINDEX_REALIP}real_ip_header X-Forwarded-For; real_ip_recursive on;"
fi
export FDPINDEX_REALIP
