# Copy to deploy/.env and adjust.
POSTGRES_PASSWORD=change-me
# Digest of an admin token: `docker compose run --rm server fdpindex token new`
FDPINDEX_ADMIN_TOKENS=
# OIDC sign-in (optional): issuer, audience, and the public client ID for the app.
FDPINDEX_OIDC_ISSUER=
FDPINDEX_OIDC_AUDIENCE=
FDPINDEX_OIDC_CLIENT_ID=
# Where the server reads the issuer's configuration, if not at the issuer's address.
FDPINDEX_OIDC_DISCOVERY_URL=
# With `--profile keycloak` (local trials), use instead:
# FDPINDEX_OIDC_ISSUER=http://localhost:8180/realms/fdpindex
# FDPINDEX_OIDC_AUDIENCE=fdpindex
# FDPINDEX_OIDC_CLIENT_ID=fdpindex-app
# FDPINDEX_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/fdpindex/.well-known/openid-configuration
# KEYCLOAK_ADMIN_PASSWORD=change-me
FDPINDEX_AUTO_PERMIT=true
# Local stacks only: allow checking FDPs on private / loopback addresses.
FDPINDEX_OUTBOUND_ALLOW_PRIVATE=false
FDPINDEX_PORT=8090
# Interface to publish on; 127.0.0.1 keeps the stack local.
FDPINDEX_BIND=127.0.0.1
# Public origin of the app, when it differs from what the browser sees.
FDPINDEX_PUBLIC_ORIGIN=
# Behind another reverse proxy (TLS termination): its address or CIDR range(s).
FDPINDEX_TRUSTED_PROXY=
# Fetch labels of concepts (subjects, themes, publishers) from their vocabularies:
# Wikidata, MeSH, ROR, OLS … (ADR-0006). Sends requests to those services.
FDPINDEX_LABELS_RESOLVE=false
