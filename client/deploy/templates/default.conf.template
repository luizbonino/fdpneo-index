# FDPneo Index: one origin for people and FDPs. The app is static; API paths
# and pings (POST /) go to the index server at ${FDPINDEX_API_UPSTREAM}.
#
# Note: a location with its own add_header drops every add_header inherited
# from the server block, so the app locations repeat the security headers.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 256k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Behind another reverse proxy: trust its X-Forwarded-For (FDPINDEX_TRUSTED_PROXY).
    ${FDPINDEX_REALIP}

    # $http_host keeps the port (127.0.0.1:8090), so links the server writes work.
    proxy_set_header Host $http_host;
    # The address that connected, never one the client claims: the server keys
    # its per-address rate limits on this. Behind another reverse proxy,
    # FDPINDEX_TRUSTED_PROXY makes $remote_addr the client's (realip module).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    # FDPs ping the root: POST / is the API, everything else at / is the app.
    location = / {
        if ($request_method = POST) {
            rewrite ^ /__ping last;
        }
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "${FDPINDEX_CSP}" always;
        try_files /index.html =404;
    }

    location = /__ping {
        internal;
        proxy_pass ${FDPINDEX_API_UPSTREAM}/;
    }

    location /index/ {
        proxy_pass ${FDPINDEX_API_UPSTREAM};
    }

    # /readyz stays internal: it is for the container health check, not the public.
    location ~ ^/(openapi\.json|docs|redoc|healthz)$ {
        proxy_pass ${FDPINDEX_API_UPSTREAM};
    }

    location = /config.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "${FDPINDEX_CSP}" always;
        try_files $uri $uri/ /index.html;
    }
}
