  "info": {
    "description": "A directory of FAIR Data Points: ping intake, reachability, harvest and administration.",
    "title": "FDP Index",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "service_info__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service Info",
        "tags": [
          "Service"
        ]
      },
      "post": {
        "description": "Inform about a running FAIR Data Point. It is expected to send pings regularly (at least weekly). There is a rate limit per IP address within a period of time.",
        "operationId": "receive_ping__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid ping"
          },
          "403": {
            "description": "URL denied"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Ping: announce a running FAIR Data Point",
        "tags": [
          "Index"
        ]
      }
    },
