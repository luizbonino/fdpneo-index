# FDP Index: one origin for people and FDPs. The app is static; API paths
# and pings (POST /) go to the index server at ${FDPINDEX_API_UPSTREAM}.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 256k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # FDPs ping the root: POST / is the API, everything else at / is the app.
    location = / {
        if ($request_method = POST) {
            rewrite ^ /__ping last;
        }
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location = /__ping {
        internal;
        proxy_pass ${FDPINDEX_API_UPSTREAM}/;
    }

    location /index/ {
        proxy_pass ${FDPINDEX_API_UPSTREAM};
    }

    location ~ ^/(openapi\.json|docs|redoc|healthz|readyz)$ {
        proxy_pass ${FDPINDEX_API_UPSTREAM};
    }

    location = /config.js {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
